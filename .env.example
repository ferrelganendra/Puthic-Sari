# Client-exposed (VITE_*): bundled into browser JavaScript
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
VITE_MIDTRANS_IS_PRODUCTION=false
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id/
VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
VITE_SITE_URL=https://puthicsari.com

# Server-only: ImageKit upload authentication
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# Server-only: sitemap/build scripts
SITE_URL=https://puthicsari.com
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only: Supabase Edge Functions / database
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=your_database_connection_string
PUBLIC_SITE_ORIGIN=https://puthicsari.com

# Server-only: Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_FINISH_URL=https://puthicsari.com/account

# Server-only: Biteship Shipping
BITESHIP_API_KEY=your_biteship_api_key
BITESHIP_ORIGIN_CONTACT_NAME=Puthic Sari
BITESHIP_ORIGIN_CONTACT_PHONE=your_store_phone_number
BITESHIP_ORIGIN_ADDRESS=Your store address
BITESHIP_ORIGIN_POSTAL_CODE=55283
BITESHIP_ORIGIN_LATITUDE=your_store_latitude
BITESHIP_ORIGIN_LONGITUDE=your_store_longitude
BITESHIP_COURIERS=gojek,grab,jne,jnt
BITESHIP_DEFAULT_ITEM_WEIGHT_GRAMS=500
BITESHIP_DEFAULT_ITEM_LENGTH_CM=30
BITESHIP_DEFAULT_ITEM_WIDTH_CM=20
BITESHIP_DEFAULT_ITEM_HEIGHT_CM=15
INSTANT_MAX_KM=20
SHIPPING_TEST_MODE=true
BITESHIP_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_header_name
BITESHIP_WEBHOOK_SIGNATURE_SECRET=your_webhook_signature_secret

# Server-only: Admin WhatsApp Notifications (Fonnte)
# Sign up at https://fonnte.com → get API token from dashboard
# Target number is admin's WhatsApp (with country code, no + sign)
FONNTE_TOKEN=your_fonnte_api_token
FONNTE_TARGET_NUMBER=your_admin_whatsapp_number
